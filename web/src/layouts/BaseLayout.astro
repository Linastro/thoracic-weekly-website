---
/**
 * 基础布局:HTML 骨架 + 暗色脚本(防 FOUC)+ 全局样式引入
 */

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Thoracic Weekly', description = '胸外科学术文献每日监控' } = Astro.props;

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!--
      内联暗色脚本 — 必须在 CSS 加载前执行,防 FOUC。
      默认跟随系统偏好;用户点击 ThemeToggle 后 localStorage 覆盖。
    -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme-pref');
          let theme;
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else {
            // 'system' 或首次访问:跟随系统
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="app-sidebar" id="app-sidebar">
        <slot name="sidebar">
          <!-- 默认占位,留给调用方注入 Sidebar.astro -->
          <div class="sidebar"></div>
        </slot>
      </aside>
      <!-- 移动端抽屉遮罩:点它关闭侧边栏(桌面端始终隐藏) -->
      <div class="app-sidebar-mask" aria-hidden="true"></div>
      <div class="app-main">
        <slot name="topnav-right">
          <!-- 默认占位,留待调用方注入 TopNav.astro -->
          <header class="topnav">
            <div class="topnav-brand">
              <img src="/favicon.svg" alt="logo" width="28" height="28" />
              <span>{title}</span>
            </div>
          </header>
        </slot>
        <main class="app-content">
          <slot />
        </main>
      </div>
    </div>
  </body>
  <!-- 移动端抽屉开关:汉堡按钮 + 遮罩 + 链接点击 / Esc 关闭 -->
  <script is:inline>
    (function () {
      var btn = document.querySelector('.topnav-menu-btn');
      var shell = document.querySelector('.app-shell');
      var sidebar = document.getElementById('app-sidebar');
      var mask = document.querySelector('.app-sidebar-mask');
      if (!btn || !shell || !sidebar || !mask) return;
      function open() {
        shell.classList.add('sidebar-open');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', '关闭菜单');
      }
      function close() {
        shell.classList.remove('sidebar-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', '打开菜单');
      }
      btn.addEventListener('click', function () {
        shell.classList.contains('sidebar-open') ? close() : open();
      });
      mask.addEventListener('click', close);
      sidebar.addEventListener('click', function (e) {
        if (e.target.closest('a')) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });
    })();
  </script>
</html>