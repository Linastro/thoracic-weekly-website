---
/** 顶部 nav:logo + 标题 + 右侧操作槽(ThemeToggle + 总数)。 */

interface Props {
  title?: string;
  totalCount?: number;
  totalAfterFilterId?: string;
}
const { title = 'Thoracic Weekly', totalCount, totalAfterFilterId } = Astro.props;

import ThemeToggle from '../islands/ThemeToggle';

const today = new Date().toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
});
---

<header class="topnav">
  <button
    type="button"
    class="topnav-menu-btn"
    aria-label="打开菜单"
    aria-expanded="false"
    aria-controls="app-sidebar"
  >☰</button>
  <a href="/" class="topnav-brand">
    <img src="/favicon.svg" alt="logo" width="28" height="28" />
    <span>{title}</span>
  </a>
  <div class="topnav-meta">
    {today}
    {totalCount !== undefined && (
      <>
        <span class="topnav-total"> · 共 <span id={totalAfterFilterId}>{totalCount}</span> 篇</span>
      </>
    )}
  </div>
  <ThemeToggle client:load />
</header>