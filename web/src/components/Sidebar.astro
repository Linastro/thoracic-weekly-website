---
/** 左侧 sidebar:v4 精简版(2 个内容分组 + 1 个更多分组,主题切换已上移至 TopNav)。 */

const currentPath = Astro.url.pathname;

const contentSection = [
  { href: '/', label: '全部文献', match: (p: string) => p === '/' },
  { href: '/topics', label: '主题分类', match: (p: string) => p.startsWith('/topics') },
  { href: '#', label: '周报(即将上线)', match: () => false },
];

const moreSection = [
  { href: '/about', label: '关于', match: (p: string) => p === '/about' },
  { href: '/changelog', label: '更新日志', match: (p: string) => p === '/changelog' },
  { href: '/journals', label: '期刊目录', match: (p: string) => p === '/journals' },
  { href: '/feedback', label: '反馈', match: (p: string) => p === '/feedback' },
];
---

<aside class="app-sidebar">
  <nav class="sidebar">
    <div class="sidebar-section sidebar-brand">
      <img
        class="sidebar-brand-wordmark"
        data-variant="light"
        src="/brand-wordmark-light.png"
        alt="Thoracic Weekly"
        width="480"
        height="240"
      />
      <img
        class="sidebar-brand-wordmark"
        data-variant="dark"
        src="/brand-wordmark-dark.png"
        alt="Thoracic Weekly"
        width="480"
        height="240"
      />
      <span class="sidebar-brand-by">by</span>
      <img
        class="sidebar-brand-personal"
        data-variant="light"
        src="/linastro-logo-light.png"
        alt="Linastro"
        width="480"
        height="65"
      />
      <img
        class="sidebar-brand-personal"
        data-variant="dark"
        src="/linastro-logo-dark.png"
        alt="Linastro"
        width="480"
        height="51"
      />
    </div>

    <div class="sidebar-section">
      <div class="sidebar-title">内容</div>
      <div class="sidebar-nav">
        {contentSection.map((item) => (
          <a
            href={item.href}
            class={`sidebar-link ${item.match(currentPath) ? 'active' : ''}`}
            aria-current={item.match(currentPath) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-title">更多</div>
      <div class="sidebar-nav">
        {moreSection.map((item) => (
          <a
            href={item.href}
            class={`sidebar-link ${item.match(currentPath) ? 'active' : ''}`}
            aria-current={item.match(currentPath) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</aside>