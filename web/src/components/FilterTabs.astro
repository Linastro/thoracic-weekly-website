---
/** 顶部双层筛选 chip(纯 SSR href 跳转,客户端 inline script 再覆盖 active 状态)。
 *
 * Phase A step 13:由于 output=static + 无 SSR adapter,Astro.url.searchParams
 * 在构建期拿不到查询串,所以 active state 由客户端 inline script 根据
 * window.location.search 推断。
 */
import { DISEASES, TYPES } from '../lib/types';

interface Props {
  activeDisease?: string;
  activeType?: string;
  showDiseaseRow?: boolean;
  diseaseHrefBase?: string;
  typeHrefBase?: string;
}

const {
  activeDisease,
  activeType,
  showDiseaseRow = true,
  diseaseHrefBase = '/',
  typeHrefBase = '/',
} = Astro.props;

// 全部 chip 不挂任何 slug,清空当前参数
const buildDiseaseHref = (slug: string | null) => {
  const params = new URLSearchParams();
  if (slug) params.set('disease', slug);
  const qs = params.toString();
  return qs ? `${diseaseHrefBase}?${qs}` : diseaseHrefBase;
};

const buildTypeHref = (slug: string | null) => {
  const params = new URLSearchParams();
  if (slug) params.set('type', slug);
  const qs = params.toString();
  return qs ? `${typeHrefBase}?${qs}` : typeHrefBase;
};
---

<section class="filter-bar">
  {showDiseaseRow && (
    <div class="filter-row">
      <span class="filter-label">病种</span>
      <div class="filter-chips">
        <a class="chip" href={buildDiseaseHref(null)} data-kind="disease" data-slug="">全部</a>
        {DISEASES.map((d) => (
          <a class="chip" href={buildDiseaseHref(d.slug)} data-kind="disease" data-slug={d.slug}>
            {d.name_zh}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="filter-row">
    <span class="filter-label">类型</span>
    <div class="filter-chips">
      <a class="chip" href={buildTypeHref(null)} data-kind="type" data-slug="">全部</a>
      {TYPES.map((t) => (
        <a class="chip" href={buildTypeHref(t.slug)} data-kind="type" data-slug={t.slug}>
          {t.name_zh}
        </a>
      ))}
    </div>
  </div>
</section>
