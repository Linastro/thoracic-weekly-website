---
/** 搜索控件 island 挂载点(第 12 步从 disabled 占位升级为 SearchIsland)。 */
import SearchIsland from '../islands/SearchIsland';
import type { Article } from '../lib/types';

interface Props {
  articles: Article[];
  disease?: string;
  type?: string;
}

const { articles, disease, type } = Astro.props;
---

<SearchIsland articles={articles} disease={disease} type={type} client:load />