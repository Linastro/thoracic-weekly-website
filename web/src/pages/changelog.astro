---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Sidebar from '../components/Sidebar.astro';
import { loadAllSnapshots } from '../lib/data';

const snaps = loadAllSnapshots();
const totalArticles = snaps.reduce((acc, s) => acc + s.article_count, 0);
---

<BaseLayout title="更新日志 - Thoracic Weekly">
  <Fragment slot="sidebar"><Sidebar /></Fragment>
  <Fragment slot="topnav-right"><TopNav totalCount={totalArticles} /></Fragment>

  <h1 class="page-title">更新日志</h1>
  <p class="page-subtitle">共 {snaps.length} 天 · {totalArticles} 篇文献</p>

  <table class="changelog-table">
    <thead>
      <tr>
        <th>日期</th>
        <th>文章数</th>
        <th>生成时间</th>
      </tr>
    </thead>
    <tbody>
      {snaps.map((s) => (
        <tr>
          <td><time datetime={s.date}>{s.date}</time></td>
          <td>{s.article_count}</td>
          <td>{s.generated_at.slice(0, 19).replace('T', ' ')}</td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>