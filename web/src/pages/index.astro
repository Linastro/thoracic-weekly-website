---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Sidebar from '../components/Sidebar.astro';
import FilterTabs from '../components/FilterTabs.astro';
import SearchBox from '../components/SearchBox.astro';
import { loadAllArticles } from '../lib/data';
import { parseFilter } from '../lib/url';

const filter = parseFilter(Astro.url.searchParams);

// 客户端 island 需要完整 articles 数组(由 React 在浏览器端过滤)
const articles = loadAllArticles();

const totalArticles = articles.length;
---

<BaseLayout title="胸外文献每日监控">
  <Fragment slot="sidebar">
    <Sidebar />
  </Fragment>
  <Fragment slot="topnav-right">
    <TopNav totalCount={totalArticles} />
  </Fragment>

  <FilterTabs activeDisease={filter.disease} activeType={filter.type} />

  <SearchBox articles={articles} disease={filter.disease} type={filter.type} />
</BaseLayout>