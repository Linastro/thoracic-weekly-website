# ===== PubMed =====
# (User obtains from https://www.ncbi.nlm.nih.gov/account/settings/)
# With key: 10 RPS / Without key: 3 RPS
PUBMED_API_KEY=

# ===== MiniMax M3 (LLM classification and translation) =====
# OpenAI-compatible endpoint
LLM_BASE_URL=https://api.MiniMax.chat/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT=3
LLM_BATCH_SIZE=10

# ===== Reverse-trigger authentication (backfill endpoint) =====
# Generate with: openssl rand -hex 32
REGEN_TOKEN=change-me-to-a-long-random-string

# ===== Time zone and storage =====
TZ=Asia/Shanghai
DB_PATH=/data/thoracic.db
SNAPSHOT_DIR=/data/snapshots

# ===== Logging =====
LOG_LEVEL=INFO
